# .env.example — variable NAMES only, never real values.
# The ONE env file ever committed. Copy it to deployment/local/.env and fill
# in real values there; that copy is never committed.

# --- database ---
# Postgres connection string (docker compose service `db` tạo sẵn user/pass/db)
DATABASE_URL=

# --- auth provider ---
# "local" (default): iron-session + Argon2id, zero SaaS | "clerk": dùng Clerk
AUTH_PROVIDER=
# local mode: email duy nhất được đăng nhập
ORBIT_USER_EMAIL=
# local mode: secret mã hoá session cookie, tối thiểu 32 ký tự — deployment/local/.env only
SESSION_SECRET=
# clerk mode keys — bỏ trống khi dùng local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# secret — deployment/local/.env only
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# --- jobs provider ---
# "none" (default): không infra gì thêm | "temporal": cần Temporal server + worker process
JOBS_PROVIDER=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=

# --- cache provider ---
# "memory" (default) | "redis" (cần REDIS_URL)
CACHE_PROVIDER=
REDIS_URL=

# --- runtime ---
# Next.js tự đặt ("development"/"production"), không cần set tay
NODE_ENV=
