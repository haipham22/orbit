    "owner_authority": "Hải Phạm",
    "purpose": "Gói nền light cho orbit (PMS cá nhân, Gen Z 13+): tokens + components + screens cho 8 màn vòng 1, dịch từ hướng cool-console đã chốt (huong-4 / orbit prototype 0.2.1).",
    "changelog": [
      {
        "date": "2026-10-27",
        "version": 1,
        "change": "Khởi tạo từ huong-4 cool-console + orbit prototype tokens 0.2.1"
      },
      {
        "date": "2026-10-28",
        "version": 1,
        "change": "Authority nghiệm thu vòng 1 — APPROVED, đóng gói bàn giao"
      },
      {
        "date": "2026-10-28",
        "version": 2,
        "change": "Vòng 2 additive: color.success-soft + color.warning-soft (chip trạng thái done/tới hạn); 6 component mới, mở rộng biến thể Chip/TextInput/NavItem/Modal, packaging ui/*.tsx standalone; success light đậm #1B7F3B → #177034 (đệm tương phản chip done 4.51 → 5.50); thêm color.border-soft (viền toast mềm, feedback Authority)"
      },
      {
        "date": "2026-10-28",
        "version": 2,
        "change": "Authority nghiệm thu vòng 2 — APPROVED, đóng gói bàn giao v1.1"
      },
      {
        "date": "2026-10-28",
        "version": 3,
        "change": "Vòng 3: messages vi/en + patch consume v2 (onOpenChange, Chip color prop, Nav asChild, DateInput/DateRange locale labels, disabled attr, a11y) + color.data-ink/data-paper"
      },
      {
        "date": "2026-10-28",
        "version": 3,
        "change": "Authority nghiệm thu vòng 3 — APPROVED, đóng gói bàn giao v3"
      }
    ]
  },
